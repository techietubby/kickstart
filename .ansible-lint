---
# vars/*.yml use camelCase names (vmName, ksTemplate, ...) that are consumed
# by provision-vm.yml, template.xml and every templates/*.j2 kickstart file.
# Renaming them is a repo-wide refactor, so the naming rule is skipped.
skip_list:
  - var-naming[pattern]

# Opt-in security rule: tasks that handle a password must set no_log.
enable_list:
  - no-log-password
