text # --non-interactive

{% if (osVer == 'centos8' or osVer == 'centos-stream8') -%}
# Create AppStream Repo
repo --name="AppStream" --baseurl=file:///run/install/repo/AppStream
{% endif -%}

{% if osVer.startswith('centos') -%}
# openSCAP newer than base - only needed on CentOS 7/8 (COPR was retired; EL9 ships it in AppStream)
repo --name=openscap-latest --baseurl={{ openScap }}
{% endif -%}

skipx

# System authorization information (authconfig/auth removed in EL9)
authselect select sssd

# Root password
rootpw {{ rootPw }} --iscrypted

# Use CDROM installation media
cdrom

# Run the Setup Agent on first boot
firstboot --disable
eula --agreed

# Keyboard layouts
keyboard --vckeymap={{ vcKeymap }} --xlayouts='{{ xLayouts }}'

# System language
lang {{ lang }} --addsupport=en_US

# Network information
network --device={{ netDevice }} --onboot=on --activate --bootproto=static --ip={{ netIp }} --netmask={{ netMask }} --gateway={{ gateWay }} --nameserver={{ nameServer }} --noipv6 --hostname={{ hostName }}

#%pre  --log=/var/log/ks-pre.log
#%end

# Firewall - single-use command: one line, or only the last one wins
firewall --enabled --service={{ fwService | join(',') }} --port={{ fwPort | join(',') }}

# System services
services --enabled=chronyd --enabled=firewalld --enabled=rngd

# System timezone
timezone {{ timeZone }} --utc

logging

# Set SELinux to Enforcing mode
selinux --enforcing

# System bootloader configuration
bootloader --location=mbr --boot-drive=/dev/vda --append=" crashkernel=auto modprobe.blacklist=floppy nopti noibrs noibpb" --timeout=3

ignoredisk --only-use=vda

# Partition clearing information
# clearpart --all --initlabel --drives=/dev/disk/by-path/pci-0000:04:00.0
clearpart --all --initlabel --drives=vda
zerombr

# Disk partitioning information
part /boot --asprimary --fstype="xfs" --size={{ bootSize | default(1024) }}
part pv.1 --size={{ pvSize | default(40) }} --grow --ondisk=/dev/{{ targetDev }} --asprimary
volgroup {{ rootVg }} --pesize=4096 pv.1

{% for diskPart in logVol %}
{% if diskPart.mountPoint == "none" %}
logvol {{ diskPart.mountPoint }} --fstype {{ diskPart.fsType }} --name={{ diskPart.lvName }} --vgname={{ rootVg }} --size={{ diskPart.lvSize }}
{% else %}
logvol {{ diskPart.mountPoint }} --fstype {{ diskPart.fsType }} --name={{ diskPart.lvName }} --vgname={{ rootVg }} --size={{ diskPart.lvSize }}{% if diskPart.grow | default(false) %} --grow{% endif %}{% if diskPart.fsOptions != "none" %} --fsoptions="{{ diskPart.fsOptions }}"{% endif %}

{% endif %}
{% endfor %}

# Add users
{% for user in userName %}
user --name={{ user.name }} --uid={{ user.uid }} --gecos="{{ user.gecos }}" --groups="{{ user.groups }}"{% if user.password is defined %} --password={{ user.password }} --iscrypted{% endif %}

{% endfor %}

%packages --ignoremissing --excludedocs

#@^minimal-environment
@core --nodefaults
NetworkManager
acpid
kernel
firewalld
yum-utils
openssh-clients
kexec-tools
setroubleshoot-server 
policycoreutils-devel 
policycoreutils-gui
ipa-client
#-biosdevname
vim
wget
curl
libselinux-python

-abrt-libs
-abrt-tui
-abrt-cli
-abrt
-abrt-addon-python
-abrt-addon-ccpp
-abrt-addon-kerneloops
-kernel-tools-libs
-kernel-tools
-kernel-headers
-iprutils
# -iscsi-initiator-utils

libselinux-python

policycoreutils-python
policycoreutils-gui
rng-tools

selinux-policy-targeted
setroubleshoot-server
vim
wget
