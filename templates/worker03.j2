-zd1211-firmware
%end

#%pre  --log=/var/log/ks-pre.log
#%end

%post --log=/var/log/ks-post.log

# Update system
yum update -y
# Configure SSH
mkdir -pm 0700 /root/.ssh
echo "{{ publicKey }}" > /root/.ssh/authorized_keys
chmod 0600 /root/.ssh/authorized_keys

# Keep key-based root SSH login working even after OpenSCAP remediation
# (pci-dss profile may set PermitRootLogin no in /etc/ssh/sshd_config).
# EL9 sshd reads sshd_config.d/*.conf in lexical order and the first value
# wins. The pci-dss remediation writes 00-complianceascode-hardening.conf
# (PermitRootLogin no), so this file must sort before it: "00-00" < "00-c".
mkdir -p /etc/ssh/sshd_config.d
cat > /etc/ssh/sshd_config.d/00-00-permit-root.conf <<EOF
PermitRootLogin prohibit-password
EOF
chmod 0600 /etc/ssh/sshd_config.d/00-00-permit-root.conf

/usr/bin/systemctl enable firewalld.service
/usr/bin/systemctl start firewalld.service
/usr/bin/systemctl mask tmp.mount

# Configure ntp
systemctl enable --now chronyd
#systemctl enable --now ntpd

# Configure resolv.conf 
cat > /etc/resolv.conf <<EOF
search persephone.local bluefinch.local
nameserver 192.168.0.50
nameserver 62.179.104.196
nameserver 213.46.228.196
options timeout:2 attempts:1
EOF

cat >> /etc/sysconfig/network <<EOF
RES_OPTIONS="timeout:2 attempts:1"
EOF

chmod 0644 /etc/resolv.conf /etc/sysconfig/network

# Create Ansible sudo rules
cat > /etc/sudoers.d/ansible <<EOF
Defaults !requiretty
ansible ALL=(ALL) NOPASSWD:ALL
EOF

# Weekly TRIM so freed blocks are released back to the host (disk discard=unmap)
systemctl enable fstrim.timer

# Configure firewall for ipa
firewall-cmd --permanent --add-service={kerberos,mountd,nfs,rpc-bind}

# Join IPA (ipa-client comes from %packages; EL9 has no idm module stream)
ipa-client-install --server={{ ipaServer }} --domain={{ ipaDomain }} --principal=admin --password={{ ipaAdminPassword | quote }} --mkhomedir --force-join --unattended

# Install OpenSCAP
yum install -y GConf2 dbus-glib libxslt xml-common openscap openscap-scanner scap-security-guide

# scap-workbench

systemctl unmask tmp.mount
systemctl enable tmp.mount
# systemctl enable --now cockpit.socket

yum update -y
%end

%addon com_redhat_kdump --enable --reserve-mb=128
%end

# Enable OpenSCAP (EL9 addon is org_fedora_oscap)
%addon org_fedora_oscap
content-type = scap-security-guide
profile = pci-dss
%end

# Reboot after installation
reboot
